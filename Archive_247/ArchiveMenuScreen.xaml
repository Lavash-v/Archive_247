<UserControl x:Class="Archive_247.ArchiveMenuScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgColor}">

    <Grid>
        <StackPanel Margin="40,40,0,0" VerticalAlignment="Top">

            <TextBlock Text="АРХИВ" Style="{StaticResource TerminalText}" FontSize="32" Margin="0,0,0,5"/>
            <TextBlock Text="ДЕЛО №247" Style="{StaticResource TerminalText}" FontSize="16" Margin="0,15,0,50"/>

            <Button x:Name="CameraSystemBtn" 
                    Content=">>> camera system" 
                    Style="{StaticResource TerminalLinkButton}" 
                    Click="CameraSystemBtn_Click"/>

            <Button x:Name="DeletedBtn" 
        Content=">>> deleted / ONLY ADMIN RIGHTS" 
        Style="{StaticResource TerminalLinkButton}" 
        Margin="0,15,0,0" 
        Click="DeletedBtn_Click"/>

            <Button x:Name="ExitBtn" 
                    Content=">>> exit" 
                    Style="{StaticResource TerminalLinkButton}" 
                    Margin="0,15,0,0" 
                    Click="ExitBtn_Click"/>

        </StackPanel>
    </Grid>
</UserControl>