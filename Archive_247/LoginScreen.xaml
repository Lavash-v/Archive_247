<UserControl x:Class="Archive_247.LoginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgColor}">

    <Grid>
        <StackPanel Margin="40,40,0,0" VerticalAlignment="Top">

            <TextBlock Text="ВХОД В АРХИВ" Style="{StaticResource TerminalText}" FontSize="32" Margin="0,0,0,5"/>
            <TextBlock Text="ДЕЛО №247" Style="{StaticResource TerminalText}" FontSize="16" Margin="0,15,0,50"/>

            <Button x:Name="EnterPasswordBtn" 
                    Content=">>> enter password" 
                    Style="{StaticResource TerminalLinkButton}" 
                    Click="EnterPasswordBtn_Click"/>

            <Button x:Name="ExitBtn"
                    Content=">>> exit"
                    Style="{StaticResource TerminalLinkButton}"
                    Margin="0,15,0,0"
                    Click="ExitBtn_Click" />

        </StackPanel>
    </Grid>
</UserControl>