<Window x:Class="Archive_247.MainWindow"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive Terminal" 
        Width="1366" Height="768"
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgColor}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid x:Name="MainContentGrid" />

        <Rectangle Opacity="0.1" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,10,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,10,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Image gif:ImageBehavior.AnimatedSource="/images/vintage vhs GIF by rotomangler.gif"
               Stretch="UniformToFill"
               Opacity="0.5"
               IsHitTestVisible="False"
               Panel.ZIndex="99"/>
        
        <MediaElement x:Name="BackgroundNoise" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop"
                      Volume="0.1" 
                      MediaEnded="BackgroundNoise_MediaEnded" />

        <!-- Скрытый плеер для звуков интерфейса -->
        <MediaElement x:Name="UiSoundPlayer" 
              LoadedBehavior="Manual" 
              UnloadedBehavior="Stop" 
              Volume="1" 
              Width="1" Height="1" 
              Opacity="0" 
              IsHitTestVisible="False" />
    </Grid>
</Window>