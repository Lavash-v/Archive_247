<UserControl x:Class="Archive_247.PasswordScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgColor}">

    <Grid>
        <StackPanel Margin="40,40,0,0" VerticalAlignment="Top">

            <TextBlock Text="bash-247# passwd" Style="{StaticResource TerminalText}" Margin="0,0,0,30"/>

            <TextBlock Text="You can now enter the secret code" Style="{StaticResource TerminalText}" Margin="0,0,0,10"/>
            <TextBlock Text="A valid password must consist exclusively of 6 digits." Style="{StaticResource TerminalText}" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                <TextBlock Text="Enter password: " Style="{StaticResource TerminalText}" VerticalAlignment="Center"/>
                <TextBox x:Name="PasswordInput" 
                         Style="{StaticResource TerminalTextBox}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Width="200" 
                         MaxLength="6" 
                         Foreground="White" 
                         CaretBrush="White"
                         TextChanged="PasswordInput_TextChanged"/>
            </StackPanel>

            <!-- Статус сообщение (SUCCESSFULL / INCORRECT) -->
            <TextBlock x:Name="StatusMessage" 
                       Style="{StaticResource TerminalText}" 
                       FontSize="36" 
                       HorizontalAlignment="Center" 
                       Margin="0,40,0,0" 
                       Visibility="Collapsed"/>

            <Button x:Name="BackBtn" 
                    Content=">>> exit" 
                    Style="{StaticResource TerminalLinkButton}" 
                    HorizontalAlignment="Left" 
                    Margin="0,50,0,0" 
                    Click="BackBtn_Click"/>

        </StackPanel>
    </Grid>
</UserControl>