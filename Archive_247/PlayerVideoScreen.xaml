<UserControl x:Class="Archive_247.PlayerVideoScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black">

    <Grid>
        <MediaElement x:Name="VideoPlayer" 
                      LoadedBehavior="Manual" 
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill" 
                      MediaEnded="VideoPlayer_MediaEnded"/>

        <Rectangle Fill="Black" Opacity="0.3" IsHitTestVisible="False" />

        <Grid VerticalAlignment="Top" Margin="40,20,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ЗАПИСИ С КАМЕР" Style="{StaticResource TerminalText}" FontSize="32"/>
                <TextBlock Text="ДЕЛО №247" Style="{StaticResource TerminalText}" FontSize="16" Margin="0,15,0,0"/>
                
                <TextBlock Grid.Column="1" Text="29-10-2026" Style="{StaticResource TerminalText}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock x:Name="SelectedCamHeader" Text="CAM 01" Style="{StaticResource TerminalText}" FontSize="32" HorizontalAlignment="Right"/>
                <TextBlock x:Name="FloorHeader" Text="2 ЭТАЖ" Style="{StaticResource TerminalText}" FontSize="16" HorizontalAlignment="Right" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>

        <Canvas Width="600" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0.85">

            <Image Source="/images/План _ Камеры.png" 
           Width="600" 
           Height="500" 
           Stretch="Uniform" 
           Opacity="0.8"/>

            <Button Name="Btn07" Content="07" Tag="CAM 07" Style="{StaticResource CameraButton}" Canvas.Left="300" Canvas.Top="10" Click="CameraButton_Click"/>
            <Button Name="Btn02" Content="02" Tag="CAM 02" Style="{StaticResource CameraButton}" Canvas.Left="224" Canvas.Top="193" Click="CameraButton_Click"/>
            <Button Name="Btn01" Content="01" Tag="CAM 01" Style="{StaticResource CameraButton}" Canvas.Left="224" Canvas.Top="237" Click="CameraButton_Click"/>

            <Button Name="Btn03" Content="03" Tag="CAM 03" Style="{StaticResource CameraButton}" Canvas.Left="78"  Canvas.Top="360" Click="CameraButton_Click"/>
            <Button Name="Btn04" Content="04" Tag="CAM 04" Style="{StaticResource CameraButton}" Canvas.Left="136" Canvas.Top="341" Click="CameraButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button Name="Btn05" Content="05" Tag="CAM 05" Style="{StaticResource CameraButton}" Canvas.Left="197" Canvas.Top="336" Click="CameraButton_Click"/>

            <Button Name="Btn06" Content="06" Tag="CAM 06" Style="{StaticResource CameraButton}" Canvas.Left="109"  Canvas.Top="472" Click="CameraButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Name="Btn08" Content="08" Tag="CAM 08" Style="{StaticResource CameraButton}" Canvas.Left="289" Canvas.Top="446" Click="CameraButton_Click"/>
            <Button Name="Btn09" Content="09" Tag="CAM 09" Style="{StaticResource CameraButton}" Canvas.Left="506" Canvas.Top="416" Click="CameraButton_Click"/>
        </Canvas>

        <Button x:Name="BackBtn" 
                Content=">>> exit" 
                Style="{StaticResource TerminalLinkButton}" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Left" 
                Margin="40,0,0,20" 
                Click="BackBtn_Click" 
                Panel.ZIndex="10"/>
    </Grid>
</UserControl>